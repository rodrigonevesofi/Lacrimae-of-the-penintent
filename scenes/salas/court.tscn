[node name="Seal" type="Node2D" parent="Vestigios" unique_id=594899292]
position = Vector2(1400, 950)
script = ExtResource("6_7tj13")
id_vestigio = "seal"
nome = "Os Portões Selados"
texto = "Os portões estão fechados por fora, com correntes que ninguém forjou aqui.
Gravado na madeira, sob um selo raspado: \"POR ORDEM DO SELO: NINGUÉM SAIRÁ, NINGUÉM ENTRARÁ.\"

Abaixo, riscado por unhas: \"Pai, abra. Estamos aqui.\"

Este caminho ainda não se abre.
Algo que você carrega ainda é a chave."
recompensa = 0

[node name="Decree" type="Node2D" parent="Vestigios" unique_id=376080865]
position = Vector2(1300, 710)
script = ExtResource("6_7tj13")
id_vestigio = "decree"
nome = "Decreto selado em cera"
texto = "\"Quem lamentar será tratado como cúmplice da praga.
Quem chorar será contado entre os culpados.\"

O nome no selo foi raspado a faca. O pulso que assinou tremia.
Pela primeira vez, você duvida de quem ordenou.

+200 lágrimas."
recompensa = 200

