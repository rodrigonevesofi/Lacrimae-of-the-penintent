extends "res://tests/exploration_smoke.gd"
## Revisão encenada com cortes entre situações; não é uma partida completa.
func shot(label: String) -> void:
	await RenderingServer.frame_post_draw
	root.get_texture().get_image().save_png("/tmp/v09-"+label+".png")
func tap(action: String) -> void:
	Input.action_press(action)
	await frames(1)
	Input.action_release(action)
func run() -> void:
	game=load("res://scenes/main.tscn").instantiate()
	root.add_child(game)
	game._start_game(false,true)
	quiet_enemies()
	game.narrative.begin("opening")
	await frames(350)
	await shot("opening")
	game.narrative.finish()
	while game.message_text!="": await close_message()
	game.player.has_weapon=true
	game.player.position=Vector2(540,600)
	game.player.camera.reset_smoothing()
	await frames(45)
	game.narrative.begin("prayer")
	await frames(150)
	await shot("prayer")
	await frames(150)
	quiet_enemies()
	game.player.position=Vector2(1050,600)
	game.player.camera.reset_smoothing()
	await frames(40)
	await shot("passage")
	await go(1160,600)
	await interact()
	await frames(90)
	await shot("ossuary")
	game.exploration.travel("city",Vector2(2780,600))
	await frames(30)
	game.doll_found=true
	game.exploration.collected.append("register")
	game.story_flags.append("names_read")
	game.player.position=Vector2(2850,600)
	await frames(40)
	await tap("interact")
	await frames(160)
	await shot("memorial")
	while game.message_text!="": await close_message()
	game.player.position=Vector2(1580,600)
	game.player.camera.reset_smoothing()
	await frames(45)
	await tap("attack")
	await frames(16)
	await tap("attack")
	await frames(45)
	await tap("jump")
	await frames(8)
	await tap("attack")
	await frames(15)
	await shot("air-cut")
	await frames(70)
	game.exploration.map_open=true
	await frames(120)
	await shot("map")
	game.exploration.map_open=false
	game.soundscape.set_process(false)
	game.soundscape.ambience.stop()
	game.soundscape.incoming.stop()
	game.soundscape.guilt_layer.stop()
	for voice in game.soundscape.effects.values(): voice.stop()
	await frames(20)
	game._delete_save()
	game.queue_free()
	await frames(8)
	quit()
