[node name="Inscricoes" type="Node2D" parent="." unique_id=1018347344]

[node name="Inscricao1" type="Node2D" parent="Inscricoes" unique_id=2105036492]
position = Vector2(730, 900)
script = ExtResource("6_bd6si")
titulo = "A Primeira Mártir"
texto = "Diante de um antigo altar, ela chorou sangue.
Os registros dizem que centenas receberam absolvição.

Desde então, Vespera passou a medir a culpa em lágrimas."

[node name="Inscricao2" type="Node2D" parent="Inscricoes" unique_id=133164793]
position = Vector2(1390, 900)
script = ExtResource("6_bd6si")
titulo = "A Regra do Confessor"
texto = "Bem-aventurados os que choram.

Um decreto sem nome: quem não chora deverá aprender a dor.
Uma segunda mão riscou: misericórdia quero, não sacrifício.

À margem: procure no campanário aquilo que ainda o ergue."

[node name="Inscricao3" type="Node2D" parent="Inscricoes" unique_id=2044609946]
position = Vector2(2630, 900)
script = ExtResource("6_bd6si")
titulo = "A Pedra e a Sentença"
texto = "Quem está sem pecado, atire a primeira pedra.

A Ordem raspou a primeira linha. Conservou as pedras.
As lágrimas levaram o remorso. Os atos permaneceram."

[node name="Inscricao4" type="Node2D" parent="Inscricoes" unique_id=1713095345]
position = Vector2(3860, 900)
script = ExtResource("6_bd6si")
titulo = "Os Portões Fechados"
texto = "Foi a justiça que ergueu estes portões.

A sentença foi gravada acima da tranca.
Embaixo, alguém riscou: aqui também esperavam crianças.

A assinatura foi raspada. Sua mão treme ao tocar a pedra."

